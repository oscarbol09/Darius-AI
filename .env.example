# ═════════════════════════════════════════════════════════════════════════════
#  DARIUS AI — Variables de Entorno y BYOK (Bring Your Own Key)
#  Copia este archivo como .env y completa los valores deseados.
#  También puedes configurarlos directamente en la GUI (Botón: ⚙ AJUSTES IA).
# ═════════════════════════════════════════════════════════════════════════════

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Consigue tu API key en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── OpenAI / ChatGPT ──────────────────────────────────────────────────────────
# Consigue tu API key en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Consigue tu API key en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── NVIDIA NIM ────────────────────────────────────────────────────────────────
# Consigue tu API key en: https://build.nvidia.com/
NVIDIA_API_KEY=

# ── Groq Cloud ────────────────────────────────────────────────────────────────
# Consigue tu API key en: https://console.groq.com/keys
GROQ_API_KEY=

# ── Servidores Locales / Personalizados ────────────────────────────────────────
# Ollama no requiere clave (por defecto en http://localhost:11434/v1)
# CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://localhost:1234/v1

# ── Porcupine (detección wake-word opcional) ──────────────────────────────────
# Consigue AccessKey en: https://console.picovoice.ai/
PORCUPINE_ACCESS_KEY=
